[data]
name = memad-kg
description = MeMAD knowledge graph (INA broadcast archive and Yle programmes in EBUCore, plus the MeMAD ontology)

[index]
INPUT_FILES =
MULTI_INPUT_JSON = [
  { "cmd": "cat \"{}\"", "format": "ttl", "graph": "http://data.memad.eu/graph/ina-ld", "for-each": "../source/dumps/ina-ld/*.ttl" },
  { "cmd": "cat \"{}\"", "format": "nt", "graph": "http://data.memad.eu/ontology", "for-each": "../source/ontology/*.nt" },
  { "cmd": "cat \"{}\"", "format": "ttl", "graph": "http://data.memad.eu/ontology", "for-each": "../source/ontology/*.ttl" }]
STXXL_MEMORY = 2G
VOCABULARY_TYPE = on-disk-compressed
TEXT_INDEX = from_literals
ADD_HAS_WORD_TRIPLES = true

[server]
HOST_NAME = 0.0.0.0
PORT = 7019
MEMORY_FOR_QUERIES = 4G
CACHE_MAX_SIZE = 1G
TIMEOUT = 120s

[runtime]
SYSTEM = native
